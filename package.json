{
    "name": "gamequeue",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @gamequeue/server\" \"npm run dev -w @gamequeue/web\"",
        "build": "npm run build -w @gamequeue/web && npm run build -w @gamequeue/server",
        "start": "npm run start -w @gamequeue/server",
        "test": "npm test --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "db:generate": "npm run db:generate -w @gamequeue/server",
        "igdb:mirror": "npm run igdb:mirror -w @gamequeue/server --",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "concurrently": "^10.0.6",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "vite": "^8.3.4"
    }
}
