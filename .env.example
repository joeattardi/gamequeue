# Copy to .env next to compose.yaml on the Pi (never commit .env). See DEPLOYMENT.md.
ALLOWED_ORIGINS=https://gamequeue.app
SIGNUPS_ENABLED=true
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TUNNEL_TOKEN=
# Optional: wishlist and game-page prices from IsThereAnyDeal (https://isthereanydeal.com/apps/). Off without a key.
ITAD_API_KEY=
# Two-letter country code: picks the shops and currency prices are shown in
ITAD_COUNTRY=US
# Optional: site traffic on the admin Traffic page, read from Cloudflare's analytics (needs both; see DEPLOYMENT.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional: link to the full analytics page in the Cloudflare dashboard, shown on the Traffic page
CLOUDFLARE_ANALYTICS_URL=
# Optional: email the owner on new signups through Resend (needs both; see DEPLOYMENT.md)
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM=GameQueue <alerts@mail.example.com>
# Optional: healthchecks.io ping URL for the backup job (read by scripts/backup.sh, not the app)
HEALTHCHECK_URL=
