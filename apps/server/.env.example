# Copy to .env (never commit .env)
PORT=3000
DATABASE_PATH=./data/gamequeue.db
# Local copy of IGDB built from the data dumps by `npm run igdb:mirror` (needs partner access; optional)
# IGDB_MIRROR_PATH=./data/igdb.db
SIGNUPS_ENABLED=true
# Comma-separated origins allowed to make state-changing requests (Vite dev server by default)
ALLOWED_ORIGINS=http://localhost:5173
# Public address of the site, used for absolute URLs in link previews (og:image). Defaults to the first ALLOWED_ORIGINS entry.
# PUBLIC_URL=https://gamequeue.example
# Set true only behind a reverse proxy you control (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=false
# Twitch developer app credentials for IGDB (used from M1)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Optional: the user id of the founder's account (see /admin/users); it gets a "founder" badge
FOUNDER_USER_ID=
# Optional: email me when someone signs up (Resend, https://resend.com). Both are needed.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Verification emails for new accounts (Resend). Needs RESEND_API_KEY and a sender on a domain verified in Resend;
# with both set, new accounts must confirm their email before they can use the app. Without MAIL_FROM nobody is asked to.
# MAIL_FROM=GameQueue <verify@mail.example.com>
# Most confirmation/reset emails per UTC day (default 80, under Resend's free 100); past it they are refused
# MAIL_DAILY_LIMIT=80
# Sender; the default only delivers to the email on your Resend account. Use a verified domain to change it.
# NOTIFY_FROM=GameQueue <alerts@mail.example.com>

# AI features (game helper, summaries). Off without a key; an admin also switches them on per user.
# The key stays on the server. AI_MODEL defaults to claude-sonnet-5-5; the monthly budget is set on /admin/ai.
ANTHROPIC_API_KEY=
AI_MODEL=
